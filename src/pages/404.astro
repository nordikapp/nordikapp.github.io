    <h1>404</h1>
    <p>{ui.fr.notFound} · {ui.en.notFound}</p>
    <p><a class="button" href="/">{ui.fr.backHome}</a> <a class="button" href="/en">{ui.en.backHome}</a></p>
  </section>
</Base>
