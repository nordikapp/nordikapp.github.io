---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppIcon from '../../components/AppIcon.astro';
import { site } from '../../site.config';
import { ui, href, langPaths, getLang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const t = ui[lang];
const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---
<Base lang={lang} altPath="">
  <section class="hero">
    <div class="wrap">
      <p class="kicker">{lang === 'fr' ? site.brandFr : 'The Nordic App Galaxy'}</p>
      <h1>{site.brand}</h1>
      <p class="lead">{t.tagline}</p>
    </div>
  </section>

  <section class="wrap section" id="apps">
    <h2>{t.appsTitle}</h2>
    <ul class="grid">
      {apps.map(({ id, data }) => (
        <li class="card" style={`--c:${data.color}`}>
          <a href={href(lang, `apps/${id}`)}>
            <AppIcon color={data.color} monogram={data.monogram} />
            <h3>{data.name}</h3>
            <p>{data.tagline[lang]}</p>
            <p class="meta">
              <span class="badge">{t.status[data.status]}</span>
              {data.platforms.map((p) => t.platforms[p]).join(' · ')}
            </p>
          </a>
        </li>
      ))}
      <li class="card ghost">
        <div>
          <span class="app-icon ghost-icon" aria-hidden="true">+</span>
          <h3>{t.nextApp}</h3>
          <p>{t.nextAppText}</p>
        </div>
      </li>
    </ul>
  </section>

  <section class="wrap section about">
    <h2>{t.aboutTitle}</h2>
    <p>{t.about}</p>
    <p><a class="button" href={`mailto:${site.email}`}>{t.contact} · {site.email}</a></p>
  </section>
</Base>
