---
import Doc from '../../layouts/Doc.astro';
import { site } from '../../site.config';
import { ui, langPaths, getLang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const fr = lang === 'fr';
---
<Doc lang={lang} title={ui[lang].legal} altPath="legal">
  <dl class="facts">
    <dt>{fr ? 'Dénomination' : 'Legal name'}</dt><dd>{site.legalName}</dd>
    <dt>{fr ? 'Nom d’affaires' : 'Business name'}</dt><dd>{site.brand} ({site.brandFr})</dd>
    <dt>NEQ</dt><dd>{site.neq}</dd>
    <dt>{fr ? 'Adresse' : 'Address'}</dt><dd>{site.address}</dd>
    <dt>{fr ? 'Courriel' : 'Email'}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
    <dt>{fr ? 'Fondateur' : 'Founder'}</dt><dd>{site.founders.join(', ')}</dd>
  </dl>
  <p>{fr
    ? 'Ce site est hébergé par GitHub Pages (GitHub, Inc.). Il n’utilise ni témoins (cookies) ni outil de mesure d’audience.'
    : 'This site is hosted on GitHub Pages (GitHub, Inc.). It uses no cookies and no analytics.'}</p>
</Doc>
